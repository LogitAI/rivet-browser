<?xml version="1.0" encoding="utf-8"?>
<!--
  Rivet's Windows package. This is the reduced adaptation of DSA's WiX package flow: stage
  the signed Rust payload, install it per-machine and expose the CLI on PATH.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="Rivet Browser"
             Manufacturer="LogitAI"
             Version="$(Version)"
             UpgradeCode="5a3b0f5e-fd95-44fa-93cf-5e0c517e8b37"
             Scope="perMachine"
             Compressed="yes">
        <MajorUpgrade Schedule="afterInstallExecute"
                      DowngradeErrorMessage="A newer Rivet Browser is already installed." />
        <Media Id="1" Cabinet="rivet.cab" EmbedCab="yes" />

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="Rivet Browser">
                <Directory Id="LICENSESFOLDER" Name="licenses" />
            </Directory>
        </StandardDirectory>
        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="RivetStartMenuFolder" Name="Rivet Browser" />
        </StandardDirectory>

        <Icon Id="RivetStartMenuIcon" SourceFile="$(SourceDir)\rivet.ico" />

        <ComponentGroup Id="Rivet" Directory="INSTALLFOLDER">
            <Component Id="RivetCli" Guid="*">
                <File Id="RivetCli" Source="$(SourceDir)\rivet.exe" KeyPath="yes" />
                <Environment Id="RivetPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
            </Component>
            <Component Id="RivetLauncher" Guid="*">
                <File Id="RivetLauncher" Source="$(SourceDir)\rivet-launcher.exe" KeyPath="yes" />
            </Component>
            <Component Id="RivetRuntime" Guid="*">
                <File Id="RivetRuntime" Source="$(SourceDir)\rivet_runtime_windows.dll" KeyPath="yes" />
            </Component>
            <!-- The start page Rivet windows open for a new tab, and the font it loads beside it. -->
            <Component Id="RivetStartPage" Guid="*">
                <File Id="RivetStartPage" Source="$(SourceDir)\start.html" KeyPath="yes" />
            </Component>
            <Component Id="RivetStartPageFont" Guid="*">
                <File Id="RivetStartPageFont" Source="$(SourceDir)\Manrope.ttf" KeyPath="yes" />
            </Component>
            <Component Id="RivetIcon" Guid="*">
                <File Id="RivetIcon" Source="$(SourceDir)\rivet.ico" KeyPath="yes" />
            </Component>
            <Component Id="RivetLicense" Directory="LICENSESFOLDER" Guid="*">
                <File Id="RivetLicense" Source="$(SourceDir)\LICENSE" KeyPath="yes" />
            </Component>
            <!-- The runtime embeds these fonts. The Open Font License travels with them. -->
            <Component Id="FontLicenseNewsreader" Directory="LICENSESFOLDER" Guid="*">
                <File Id="FontLicenseNewsreader" Source="$(SourceDir)\OFL-Newsreader.txt" KeyPath="yes" />
            </Component>
            <Component Id="FontLicenseManrope" Directory="LICENSESFOLDER" Guid="*">
                <File Id="FontLicenseManrope" Source="$(SourceDir)\OFL-Manrope.txt" KeyPath="yes" />
            </Component>
            <Component Id="FontLicenseDMMono" Directory="LICENSESFOLDER" Guid="*">
                <File Id="FontLicenseDMMono" Source="$(SourceDir)\OFL-DMMono.txt" KeyPath="yes" />
            </Component>
            <Component Id="RivetStartMenu" Directory="RivetStartMenuFolder" Guid="*">
                <Shortcut Id="RivetStartMenuShortcut"
                          Name="Rivet Browser"
                          Description="Rivet Browser"
                          Target="[INSTALLFOLDER]rivet-launcher.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="RivetStartMenuIcon">
                    <!-- Running Rivet windows carry the same ID, so they share this pinned button. -->
                    <ShortcutProperty Key="System.AppUserModel.ID" Value="LogitAI.Rivet.Browser" />
                </Shortcut>
                <RemoveFolder Id="RemoveRivetStartMenuFolder" On="uninstall" />
                <RegistryValue Root="HKLM" Key="SOFTWARE\LogitAI\Rivet" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
            <!--
              Rivet as a browser Windows can offer for links and HTML files. This only makes Rivet a
              choice in Settings, Default apps. It never writes the person's own choice of default; the
              person picks Rivet there. Uninstall removes every key and value written here.
              Windows runs the launcher with the address, and the launcher hands it to a Rivet
              window, whose link rules decide where it opens.
            -->
            <Component Id="RivetBrowserRegistration" Guid="6f0f6c7e-3d0e-4c55-9a7e-2b1f4c9d8e31">
                <RegistryKey Root="HKLM" Key="SOFTWARE\Clients\StartMenuInternet\RivetBrowser" ForceDeleteOnUninstall="yes">
                    <RegistryValue Type="string" Value="Rivet Browser" KeyPath="yes" />
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLFOLDER]rivet.ico" />
                    </RegistryKey>
                    <RegistryKey Key="shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]rivet-launcher.exe&quot;" />
                    </RegistryKey>
                    <RegistryKey Key="Capabilities">
                        <RegistryValue Name="ApplicationName" Type="string" Value="Rivet Browser" />
                        <RegistryValue Name="ApplicationDescription" Type="string" Value="Rivet Browser opens links in your Chromium browser with Rivet." />
                        <RegistryValue Name="ApplicationIcon" Type="string" Value="[INSTALLFOLDER]rivet.ico" />
                        <RegistryKey Key="StartMenu">
                            <RegistryValue Name="StartMenuInternet" Type="string" Value="RivetBrowser" />
                        </RegistryKey>
                        <RegistryKey Key="URLAssociations">
                            <RegistryValue Name="http" Type="string" Value="RivetURL" />
                            <RegistryValue Name="https" Type="string" Value="RivetURL" />
                        </RegistryKey>
                        <RegistryKey Key="FileAssociations">
                            <RegistryValue Name=".htm" Type="string" Value="RivetHTML" />
                            <RegistryValue Name=".html" Type="string" Value="RivetHTML" />
                        </RegistryKey>
                    </RegistryKey>
                </RegistryKey>
                <RegistryValue Root="HKLM" Key="SOFTWARE\RegisteredApplications" Name="Rivet Browser" Type="string" Value="SOFTWARE\Clients\StartMenuInternet\RivetBrowser\Capabilities" />
                <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\RivetURL" ForceDeleteOnUninstall="yes">
                    <RegistryValue Type="string" Value="Rivet Browser link" />
                    <RegistryKey Key="Application">
                        <RegistryValue Name="ApplicationName" Type="string" Value="Rivet Browser" />
                        <RegistryValue Name="ApplicationIcon" Type="string" Value="[INSTALLFOLDER]rivet.ico" />
                        <RegistryValue Name="AppUserModelId" Type="string" Value="LogitAI.Rivet.Browser" />
                    </RegistryKey>
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLFOLDER]rivet.ico" />
                    </RegistryKey>
                    <RegistryKey Key="shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]rivet-launcher.exe&quot; --open-link &quot;%1&quot;" />
                    </RegistryKey>
                </RegistryKey>
                <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\RivetHTML" ForceDeleteOnUninstall="yes">
                    <RegistryValue Type="string" Value="Rivet Browser HTML document" />
                    <RegistryKey Key="Application">
                        <RegistryValue Name="ApplicationName" Type="string" Value="Rivet Browser" />
                        <RegistryValue Name="ApplicationIcon" Type="string" Value="[INSTALLFOLDER]rivet.ico" />
                        <RegistryValue Name="AppUserModelId" Type="string" Value="LogitAI.Rivet.Browser" />
                    </RegistryKey>
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="[INSTALLFOLDER]rivet.ico" />
                    </RegistryKey>
                    <RegistryKey Key="shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]rivet-launcher.exe&quot; --open-link &quot;%1&quot;" />
                    </RegistryKey>
                </RegistryKey>
            </Component>
            <Component Id="InstallFolderRecord" Guid="a9986310-5135-4fc1-a3ac-319829bb0ea6">
                <RegistryValue Root="HKLM" Key="SOFTWARE\LogitAI\Rivet" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            </Component>
        </ComponentGroup>

        <Feature Id="Main" Title="Rivet Browser" Level="1">
            <ComponentGroupRef Id="Rivet" />
        </Feature>
    </Package>
</Wix>
